{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>andrelin/dotfiles//renovate/daily-automerge-all"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in the Dockerfile after a '# renovate:' comment",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[^\\n]*?==(?<currentValue>[^\\s\\\\]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Image dependencies wait a week before Renovate proposes them",
      "matchDatasources": [
        "docker",
        "pypi"
      ],
      "minimumReleaseAge": "7 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
